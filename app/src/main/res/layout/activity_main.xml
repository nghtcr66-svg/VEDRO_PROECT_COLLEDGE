<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:fillViewport="true"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- верхняя плашка с временем -->
        <TextView
            android:id="@+id/tvClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="18sp"
            android:text="--:--:---- --:--:--"/>

        <!-- кнопки -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnCreateRepair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@null"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Создать заявку"/>

            <Button
                android:id="@+id/btnStats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@null"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Статистика"/>

            <Button
                android:id="@+id/btnCreatePaint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Покраска"/>
        </LinearLayout>

        <!-- Ремонт -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Заявки на ремонт"
                android:textColor="#ECECEC"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <ImageButton
                android:id="@+id/btnSortAZRepair"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_alphabetically"
                android:contentDescription="Сортировать ремонт по алфавиту"
                android:tooltipText="Сортировать ремонт по алфавиту"
                app:tint="#4CAF50" />

            <ImageButton
                android:id="@+id/btnSortDateRepair"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:contentDescription="Сортировать ремонт по дате"
                android:tooltipText="Сортировать ремонт по дате"
                app:tint="#4CAF50" />
        </LinearLayout>

        <!-- заголовок таблицы ремонта -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <TableRow>
                <TextView android:text="Модель" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Дата" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Время" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Статус" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Действие" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            </TableRow>
        </TableLayout>

        <!-- тело таблицы ремонта -->
        <TableLayout
            android:id="@+id/tableRepair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:background="#101010"/>

        <!-- Покраска -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Заявки на покраску"
                android:textColor="#ECECEC"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <ImageButton
                android:id="@+id/btnSortAZPaint"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_alphabetically"
                android:contentDescription="Сортировать покраску по алфавиту"
                android:tooltipText="Сортировать покраску по алфавиту"
                app:tint="#4CAF50" />

            <ImageButton
                android:id="@+id/btnSortDatePaint"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:contentDescription="Сортировать покраску по дате"
                android:tooltipText="Сортировать покраску по дате"
                app:tint="#4CAF50" />
        </LinearLayout>

        <!-- заголовок таблицы покраски -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <TableRow>
                <TextView android:text="Модель" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Цвет" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Дата" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Статус" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Действие" android:textColor="#ECECEC" android:textStyle="bold" android:padding="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            </TableRow>
        </TableLayout>

        <!-- тело таблицы покраски -->
        <TableLayout
            android:id="@+id/tablePaint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="#101010"/>

    </LinearLayout>
</ScrollView>
